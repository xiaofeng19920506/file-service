# 飞牛 NAS 用：复制到仓库根目录
#   cp docker/env.example .env
#
# Compose 会再覆盖这几项（即使你填错也没事）：
#   DATABASE_URL → postgres 容器
#   REDIS_URL → redis 容器
#   LOCAL_STORAGE_DIR → /data/storage（映射到软件存储 ./data/storage）

POSTGRES_PASSWORD=fileservice
DATABASE_URL=postgresql://fileservice:fileservice@postgres:5432/fileservice
REDIS_URL=redis://redis:6379
STORAGE_BACKEND=fs
LOCAL_STORAGE_DIR=/data/storage
NAS_DATA_DIR=./data
WEB_PORT=4000

PORT=3000
CORS_ORIGIN=https://frontend.youtvs.com
WEB_APP_URL=https://frontend.youtvs.com
PUBLIC_BASE_URL=https://frontend.youtvs.com
MAX_UPLOAD_MB=200
DOWNLOAD_HMAC_SECRET=replace-with-at-least-16-chars
DOWNLOAD_URL_TTL_SECONDS=3600
AUTH_REQUIRED=true

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=30
EXPORT_RETENTION_DAYS=7

# Worker 镜像已内置 yt-dlp / ffmpeg，不要填本机 brew 路径
YT_DLP_PATH=yt-dlp
YOUTUBE_AUDIO_WORKER_CONCURRENCY=1
WORKER_CONCURRENCY=1
# YT_DLP_PLAYER_CLIENT=android,web
# YT_DLP_SLEEP_REQUESTS=0.75
# NAS 容器里没有你的浏览器登录态，不要开 YT_DLP_COOKIES_FROM_BROWSER

# 生产关闭 Swagger；需要时再开
# ENABLE_OPENAPI=1

# YouTube Data API（可选，配了更稳）
# YOUTUBE_API_KEY=

# 导出到 YouTube：Google Cloud 里把重定向 URI 改成下面这一条
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://frontend.youtvs.com/v1/youtube/oauth/callback

# 列表分享邮件（可选）
# SHARE_LINK_TTL_SECONDS=604800
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Cloudflare：单独建 file-service 隧道，公共主机名
# frontend.youtvs.com → HTTP → http://web:4000
# 不要和飞牛 5666 那条 host 网络隧道混用
CLOUDFLARE_TUNNEL_TOKEN=
