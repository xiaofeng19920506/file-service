# 复制为仓库根目录 .env 后再启动 Compose
#   cp docker/env.example .env
# 密钥不要提交 Git；本机若已有完整 .env，按下面改主机名即可

POSTGRES_PASSWORD=fileservice
NAS_DATA_DIR=./data
WEB_PORT=4000
FILE_SERVICE_WEB_PORT=4000

STORAGE_BACKEND=fs
LOCAL_STORAGE_DIR=/data/storage
DATABASE_URL=postgresql://fileservice:fileservice@postgres:5432/fileservice
REDIS_URL=redis://redis:6379

PORT=3000
AUTH_REQUIRED=true
DOWNLOAD_HMAC_SECRET=replace-with-at-least-16-chars
DOWNLOAD_URL_TTL_SECONDS=3600
PUBLIC_BASE_URL=https://api.youtvs.com
CORS_ORIGIN=https://frontend.youtvs.com,https://file-service-frontend-xi.vercel.app
WEB_APP_URL=https://frontend.youtvs.com

CLOUDFLARE_TUNNEL_HOSTNAME=api.youtvs.com
CLOUDFLARE_TUNNEL_NAME=file-service-api
TUNNEL_TARGET=http://api:3000
CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_TOKEN=

YT_DLP_PATH=yt-dlp
YOUTUBE_AUDIO_WORKER_CONCURRENCY=1
WORKER_CONCURRENCY=1

# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.youtvs.com/v1/youtube/oauth/callback

# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
