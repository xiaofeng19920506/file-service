FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY backend/api/package.json backend/api/
COPY backend/worker/package.json backend/worker/
COPY frontend/package.json frontend/
RUN npm ci
COPY tsconfig.base.json ./
COPY shared shared
COPY backend/api backend/api
RUN npm run build -w @file-service/shared && npm run build -w @file-service/api

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY backend/api/package.json backend/api/
COPY backend/worker/package.json backend/worker/
COPY frontend/package.json frontend/
RUN npm ci --omit=dev
COPY --from=build /app/shared/dist shared/dist
COPY --from=build /app/shared/package.json shared/
COPY --from=build /app/backend/api/dist backend/api/dist
COPY --from=build /app/backend/api/package.json backend/api/
COPY shared/drizzle shared/drizzle
EXPOSE 3000
CMD ["node", "backend/api/dist/index.js"]
