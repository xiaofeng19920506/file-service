FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY backend/api/package.json backend/api/
COPY backend/worker/package.json backend/worker/
COPY frontend/package.json frontend/
RUN npm ci
COPY tsconfig.base.json ./
COPY shared shared
COPY backend/worker backend/worker
RUN npm run build -w @file-service/shared && npm run build -w @file-service/worker

FROM node:22-bookworm-slim
COPY docker/install-media.sh /tmp/install-media.sh
RUN sed -i 's/\r$//' /tmp/install-media.sh && chmod +x /tmp/install-media.sh && /tmp/install-media.sh
WORKDIR /app
ENV NODE_ENV=production
ENV YT_DLP_PATH=/usr/local/bin/yt-dlp
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY backend/api/package.json backend/api/
COPY backend/worker/package.json backend/worker/
COPY frontend/package.json frontend/
RUN npm ci --omit=dev
COPY --from=build /app/shared/dist shared/dist
COPY --from=build /app/shared/package.json shared/
COPY --from=build /app/backend/worker/dist backend/worker/dist
COPY --from=build /app/backend/worker/package.json backend/worker/
CMD ["node", "backend/worker/dist/index.js"]
